generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ListingCopyHistory {
  id               String   @id @default(cuid())
  productId        String?
  productName      String
  title            String
  bulletPoints     String
  description      String
  shortDescription String
  keywords         String
  longTailKeywords String
  faq              String
  packingList      String
  afterSales       String
  notes            String
  sourceInput      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([createdAt])
  @@index([productName])
}

model ViralAnalysisRecord {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  type           String   @default("viral")
  decisionStatus String   @default("pending")
  title          String?
  platform       String
  productUrl     String?
  materialText   String
  source         String
  score          Int
  level          String
  oneLineSummary String
  resultJson     String

  @@index([type, createdAt])
  @@index([decisionStatus, createdAt])
  @@index([source])
  @@index([platform])
}

model OpportunityCandidate {
  id                       String            @id @default(cuid())
  name                     String
  rawInput                 String            @default("")
  link                     String?
  score                    Int               @default(0)
  source                   String            @default("机会雷达")
  keyword                  String            @default("")
  riskLevel                String            @default("")
  riskLabel                String            @default("")
  summaryLabel             String            @default("")
  status                   String            @default("pending")
  sourceMetaJson           String            @default("{}")
  analysisJson             String            @default("{}")
  convertedTaskId          String?
  originProductBatchItemId String?           @unique
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  lastActionAt             DateTime?
  originProductBatchItem   ProductBatchItem? @relation(fields: [originProductBatchItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, updatedAt])
  @@index([score])
  @@index([createdAt])
  @@index([name])
}

model ProductBatch {
  id                            String                      @id @default(cuid())
  ownerSubject                  String
  batchName                     String
  marketplace                   String
  currency                      String
  reportType                    String
  query                         String?
  category                      String?
  priceMinCents                 Int?
  priceMaxCents                 Int?
  briefHash                     String
  sourceFileName                String
  sourceFileSha256              String
  normalizedBusinessHash        String?
  snapshotHash                  String?
  manifestHash                  String?
  itemCount                     Int?
  acceptedCount                 Int?
  quarantinedCount              Int?
  dataQualityStatus             String                      @default("pending")
  batchStatus                   String                      @default("processing")
  sellerSpriteDisclaimerVersion String?
  normalizedSnapshotJson        String?
  manifestJson                  String?
  qualitySummaryJson            String                      @default("{}")
  errorJson                     String?
  dedupeKey                     String
  importedAt                    DateTime?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt
  items                         ProductBatchItem[]
  discoverySelections           ProductDiscoverySelection[]

  @@unique([ownerSubject, dedupeKey])
  @@index([ownerSubject, batchStatus, importedAt])
  @@index([ownerSubject, createdAt])
}

model ProductBatchItem {
  id                       String                @id @default(cuid())
  batchId                  String
  ordinal                  Int
  productKey               String
  asin                     String?
  parentAsin               String?
  itemIdentityHash         String
  itemHash                 String
  evidenceHash             String
  normalizedProductJson    String
  occurrenceProjectionJson String
  familyProjectionJson     String
  rankingJson              String
  provisionalDisposition   String
  researchPriority         String
  evidenceStatus           String
  promotionEligible        Boolean               @default(false)
  imageSnapshotJson        String                @default("{\"status\":\"not_cached\"}")
  createdAt                DateTime              @default(now())
  batch                    ProductBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  originCandidate          OpportunityCandidate?

  @@unique([batchId, productKey])
  @@unique([batchId, ordinal])
  @@unique([batchId, itemIdentityHash])
  @@index([batchId, evidenceStatus])
}

model ProductDiscoverySelection {
  ownerSubject               String        @id
  activeProductBatchId       String?
  activeLegacyRegistrationId String?
  updatedAt                  DateTime      @updatedAt
  activeProductBatch         ProductBatch? @relation(fields: [activeProductBatchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}


model V4ResearchRun {
  id                         String   @id @default(cuid())
  candidateId                String
  ownerScope                 String
  sandboxId                  String?
  mode                       String   @default("local_live")
  graphVersion               String   @default("research-graph.v4.1")
  status                     String   @default("draft")
  currentNode                String   @default("load_context")
  revision                   Int      @default(0)
  planRevision               Int      @default(0)
  automaticPlanRevisionCount Int      @default(0)
  stateJson                  String
  eventsJson                 String   @default("[]")
  reportJson                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([candidateId])
  @@index([ownerScope, sandboxId])
  @@index([status, updatedAt])
}

model V4SideEffectJournal {
  id             String   @id @default(cuid())
  runId          String
  idempotencyKey String
  inputHash      String
  action         String
  status         String   @default("recorded")
  detailJson     String   @default("{}")
  createdAt      DateTime @default(now())

  @@unique([runId, idempotencyKey])
  @@index([runId])
}

model V4FactRecord {
  id                String   @id @default(cuid())
  runId             String
  candidateId       String
  offerIdentity     String
  variantKey        String
  field             String
  value             String
  status            String   @default("confirmed")
  confirmationMethod String?
  claimRefsJson     String   @default("[]")
  documentRefsJson  String   @default("[]")
  actor             String
  revision          Int
  revokedByRevision Int?
  detailJson        String   @default("{}")
  createdAt         DateTime @default(now())

  @@unique([runId, offerIdentity, variantKey, field, revision])
  @@index([runId, offerIdentity, variantKey, field])
  @@index([runId, revision])
}
