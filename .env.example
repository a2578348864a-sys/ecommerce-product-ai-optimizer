AI_PROVIDER=deepseek
LISTING_PROVIDER_MODE=mock
IMAGE_PROVIDER_MODE=mock
# Listing AI 门禁（realAiListingGate 读取；LISTING_PROVIDER_MODE=real 时须为 true 才放行真实调用）
OPENAI_LISTING_ENABLED=false
# 访客是否允许真实 Listing AI（默认 false，访客体验保持 mock）
OPENAI_LISTING_VISITOR_ENABLED=false

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_BASE_URL=https://api.65535.space/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_RESULT_HOSTS=api.65535.space
# 图片 relay Base URL 的 host 白名单（provider-preflight 校验用；默认与 RESULT_HOSTS 一致）
OPENAI_IMAGE_BASE_HOSTS=api.65535.space
AI_IMAGE_DRAFT_STORAGE_ROOT=./data/ai-image-drafts

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

ACCESS_PASSWORD=change_this_password
PROOF_SIGNING_SECRET=replace_with_a_separate_random_server_secret

DATABASE_URL="file:./dev.db"

ENABLE_AI_DIAGNOSTICS=0

# ---- 公网部署（可选，本地默认值即可运行）----
# QX_RUNTIME_MODE=public_showcase
# QX_PUBLIC_ORIGIN=https://your-origin.example.com
# QX_TRUSTED_PROXY_IPS=
# OPENAI_IMAGE_GENERATION_ENABLED=false
# PROVIDER_USAGE_STORE_PATH=./data/provider-usage.json
