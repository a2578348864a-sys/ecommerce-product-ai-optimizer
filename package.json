{
  "name": "ecommerce-product-ai-optimizer",
  "version": "2.2.16",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/local-next-runtime.mjs dev",
    "build": "next build --webpack",
    "start": "next start",
    "start:local": "node scripts/local-next-runtime.mjs start",
    "check:local": "node scripts/local-next-runtime.mjs check",
    "check:provider-config": "node scripts/provider-preflight.mjs",
    "autostart:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-local-autostart.ps1 register",
    "autostart:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-local-autostart.ps1 status",
    "autostart:local:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-local-autostart.ps1 remove",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sellersprite:preview": "tsx tools/upstream/sellersprite-preview.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "demo:create": "node scripts/create-demo-password.mjs",
    "db:summary": "node scripts/db/protect-sqlite-db.mjs summary",
    "db:backup": "node scripts/db/protect-sqlite-db.mjs backup",
    "db:predeploy": "node scripts/db/protect-sqlite-db.mjs predeploy",
    "db:postdeploy": "node scripts/db/protect-sqlite-db.mjs postdeploy",
    "check": "npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "test:project-materials": "node scripts/run-project-materials-tests.mjs",
    "showcase:export": "node scripts/export-public-showcase.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@prisma/client": "5.22.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "openai": "^6.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
